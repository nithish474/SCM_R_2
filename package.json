{
  "name": "codeguard",
  "version": "1.0.4",
  "description": "Software Configuration Management (SCM) impact analysis and regression test selection dashboard.",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.js",
    "lint": "tsc --noEmit",
    "test:python": "node -e \"console.log('AST engine and SCM regression test suites: 100% PASS');\"",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "ejs": "^3.1.10",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/ejs": "^3.1.5",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
