<%- include('partials/header', { title: 'CodeGuard - Intelligent SCM Impact & Regression Analysis', activePage: 'home' }) %>

<div class="landing-container">
    <!-- 1. Mission Control Hero Section -->
    <section class="mc-hero" id="mcHeroSection">
        <div class="mc-hero-left">
            <div class="mc-badge">
                <span class="mc-live-dot"></span>
                <span>CodeGuard SCM Intelligence Engine</span>
            </div>
            
            <h1 class="mc-title">
                Understand the Impact<br>
                <span class="mc-title-accent">Before You Ship.</span>
            </h1>
            
            <p class="mc-lead">
                CodeGuard analyzes software changes, traces dependency impact, evaluates risk, intelligently selects regression tests, and generates actionable analysis.
            </p>

            <!-- Horizontal Pipeline Ribbon -->
            <div class="mc-pipeline-ribbon" aria-label="SCM Verification Pipeline Flow">
                <div class="mc-pipe-step active">
                    <span>01</span> Git Commit
                </div>
                <span class="mc-pipe-sep">&rarr;</span>
                <div class="mc-pipe-step">
                    <span>02</span> Change Detection
                </div>
                <span class="mc-pipe-sep">&rarr;</span>
                <div class="mc-pipe-step">
                    <span>03</span> AST Dependency
                </div>
                <span class="mc-pipe-sep">&rarr;</span>
                <div class="mc-pipe-step">
                    <span>04</span> Impact Analysis
                </div>
                <span class="mc-pipe-sep">&rarr;</span>
                <div class="mc-pipe-step">
                    <span>05</span> Risk Scoring
                </div>
                <span class="mc-pipe-sep">&rarr;</span>
                <div class="mc-pipe-step">
                    <span>06</span> RTS Selection
                </div>
                <span class="mc-pipe-sep">&rarr;</span>
                <div class="mc-pipe-step">
                    <span>07</span> Automated Tests
                </div>
            </div>

            <div class="mc-actions">
                <a href="/dashboard#commits" class="btn btn-primary btn-lg" id="mcAnalyzeChangeBtn">
                    <span>Analyze a Change</span>
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                        <polyline points="12 5 19 12 12 19"></polyline>
                    </svg>
                </a>
                <a href="/dashboard" class="btn btn-secondary btn-lg" id="mcExploreSystemBtn">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="3" width="7" height="9"></rect>
                        <rect x="14" y="3" width="7" height="5"></rect>
                        <rect x="14" y="12" width="7" height="9"></rect>
                        <rect x="3" y="16" width="7" height="5"></rect>
                    </svg>
                    <span>Explore Dashboard</span>
                </a>
                <button class="btn btn-outline btn-lg" id="mcAnalyzeLatestBtn" onclick="quickAnalyzeLatest()" title="Trigger immediate analysis on the latest repository commit">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polygon points="5 3 19 12 5 21 5 3"></polygon>
                    </svg>
                    <span>Analyze Latest Commit</span>
                </button>
            </div>
        </div>

        <!-- Right: Live Code Intelligence Engine Visualizer -->
        <div class="mc-hero-right">
            <div class="mc-engine-panel" id="mcEnginePanel">
                <div class="mc-engine-header">
                    <div class="mc-terminal-dots">
                        <span class="mc-dot mc-dot-red"></span>
                        <span class="mc-dot mc-dot-amber"></span>
                        <span class="mc-dot mc-dot-green"></span>
                    </div>
                    <div class="mc-engine-title">ENGINE: AST_IMPACT_PIPELINE v1.2</div>
                    <div class="mc-engine-status">
                        <span class="mc-live-dot" style="width:6px; height:6px;"></span>
                        <span>MONITORING</span>
                    </div>
                </div>

                <div class="mc-engine-body">
                    <!-- Commit Ingestion Node -->
                    <div class="mc-graph-node" id="heroNodeCommit">
                        <div class="mc-node-top">
                            <span class="mc-node-tag">SCM Ingestion</span>
                            <span class="mc-node-badge">branch: main</span>
                        </div>
                        <div class="mc-node-title d-flex align-center gap-sm">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#60a5fa" stroke-width="2">
                                <circle cx="12" cy="18" r="3"></circle>
                                <circle cx="6" cy="6" r="3"></circle>
                                <circle cx="18" cy="6" r="3"></circle>
                                <path d="M18 9v2a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V9"></path>
                                <line x1="12" y1="12" x2="12" y2="15"></line>
                            </svg>
                            <span>Commit <%= recent_commits && recent_commits[0] ? recent_commits[0].commit_hash.substring(0, 7) : 'a8f31c2' %></span>
                        </div>
                        <div class="mc-node-detail text-truncate">
                            "<%= recent_commits && recent_commits[0] ? recent_commits[0].message : 'Update core authentication and database schema validation' %>"
                        </div>
                    </div>

                    <!-- Flow Connector Line -->
                    <div class="mc-connector">
                        <div class="mc-connector-line"></div>
                    </div>

                    <!-- AST Change Detection Node -->
                    <div class="mc-graph-node" id="heroNodeAst">
                        <div class="mc-node-top">
                            <span class="mc-node-tag">AST Delta Analyzer</span>
                            <span class="mc-node-badge text-warning">Layer 1 &bull; ast.parse</span>
                        </div>
                        <div class="mc-node-title">File Modifications & Churn Detected</div>
                        <div class="mc-node-detail">
                            3 modified modules &bull; +48 / -12 lines &bull; Author: <%= recent_commits && recent_commits[0] ? recent_commits[0].author : 'DevOps Lead' %>
                        </div>
                    </div>

                    <!-- Fan-out to affected files -->
                    <div class="mc-fanout-grid">
                        <div class="mc-fanout-item">
                            <div class="mc-fanout-name">auth.py</div>
                            <div class="mc-fanout-type">Direct Delta</div>
                        </div>
                        <div class="mc-fanout-item">
                            <div class="mc-fanout-name">models.py</div>
                            <div class="mc-fanout-type">Direct Delta</div>
                        </div>
                        <div class="mc-fanout-item">
                            <div class="mc-fanout-name">api.py</div>
                            <div class="mc-fanout-type">Downstream</div>
                        </div>
                    </div>

                    <!-- Connector Line -->
                    <div class="mc-connector">
                        <div class="mc-connector-line"></div>
                    </div>

                    <!-- Risk Indicator Badge -->
                    <div class="mc-risk-indicator <%= recent_commits && recent_commits[0] && recent_commits[0].risk_level === 'High' ? 'high' : '' %>" id="heroNodeRisk">
                        <div class="mc-risk-left">
                            <span class="mc-risk-label">Calculated Change Risk</span>
                            <span class="mc-risk-val">
                                <%= recent_commits && recent_commits[0] ? recent_commits[0].risk_level.toUpperCase() : 'HIGH' %> RISK (<%= recent_commits && recent_commits[0] ? recent_commits[0].risk_score : '14.5' %> pts)
                            </span>
                        </div>
                        <div class="mc-risk-breakdown-chips">
                            <span class="mc-chip" title="Dependency Fan-out Weight">Fan-out: 3</span>
                            <span class="mc-chip" title="Historical Defect Weight">Defects: 2</span>
                            <span class="mc-chip" title="Code Churn Weight">Churn: 60</span>
                        </div>
                    </div>

                    <!-- Targeted RTS Node -->
                    <div class="mc-graph-node" style="border-color: #059669; background: #064e3b22;" id="heroNodeRts">
                        <div class="mc-node-top">
                            <span class="mc-node-tag" style="color: #34d399;">Targeted Regression Selection</span>
                            <span class="mc-node-badge" style="color: #6ee7b7; border-color: #059669;">RTS Minimizer</span>
                        </div>
                        <div class="mc-node-title" style="color: #a7f3d0;">
                            Executed <%= recent_commits && recent_commits[0] ? recent_commits[0].passed_tests : '14' %> of <%= recent_commits && recent_commits[0] ? recent_commits[0].total_tests : '14' %> Impacted Tests (100% Pass)
                        </div>
                        <div class="mc-node-detail" style="color: #6ee7b7;">
                            Skipped 42 unrelated test suites &bull; Execution time: 2.1s (92% CI speedup)
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- 2. Live System Status Bar -->
    <div class="mc-status-bar" id="mcStatusBar">
        <div class="mc-status-online">
            <span class="mc-live-dot"></span>
            <span>CODEGUARD ENGINE ONLINE</span>
        </div>
        <div class="mc-status-items">
            <div class="mc-status-pill">
                <span class="dot"></span>
                <span>AST IMPACT: <strong>ACTIVE</strong></span>
            </div>
            <div class="mc-status-pill">
                <span class="dot"></span>
                <span>DEPENDENCY GRAPH: <strong>ACTIVE</strong></span>
            </div>
            <div class="mc-status-pill">
                <span class="dot"></span>
                <span>RISK SCORING: <strong>ACTIVE</strong></span>
            </div>
            <div class="mc-status-pill">
                <span class="dot"></span>
                <span>RTS TEST ENGINE: <strong>ACTIVE</strong></span>
            </div>
            <div class="mc-status-pill">
                <span class="dot"></span>
                <span>SCM REPOSITORY: <strong><%= metrics.total_commits %> BASELINES TRACKED</strong></span>
            </div>
        </div>
    </div>

    <!-- 3. "Why CodeGuard?" Section (A Code Change Is Never Just One File) -->
    <section class="mc-section" id="whyCodeguardSection">
        <div class="mc-section-header">
            <span class="mc-eyebrow">Architectural Reality</span>
            <h2 class="mc-heading">A Code Change Is Never Just One File.</h2>
            <p class="mc-subtext">
                When a developer modifies a function or schema, the change doesn't stay confined. It silently propagates through the import hierarchy. CodeGuard makes the invisible ripple effect visible before regressions reach production.
            </p>
        </div>

        <div class="mc-ripple-card">
            <!-- Interactive Scenario Toggle Buttons -->
            <div class="mc-ripple-controls">
                <span style="font-size: 0.8rem; font-weight: 700; color: #64748b; text-transform: uppercase;">Simulate Ripple For:</span>
                <button class="mc-ripple-btn active" onclick="switchRippleScenario('payment')" id="rippleBtnPayment">
                    core/payment.py (+42 lines)
                </button>
                <button class="mc-ripple-btn" onclick="switchRippleScenario('auth')" id="rippleBtnAuth">
                    core/auth.py (+18 lines)
                </button>
                <button class="mc-ripple-btn" onclick="switchRippleScenario('models')" id="rippleBtnModels">
                    database/models.py (+65 lines)
                </button>
            </div>

            <!-- Connected 5-Stage Ripple Flow -->
            <div class="mc-ripple-flow" id="mcRippleFlow">
                <!-- Step 1 -->
                <div class="mc-ripple-step active" id="rippleStep1">
                    <div>
                        <div class="mc-ripple-step-num">Step 1</div>
                        <div class="mc-ripple-step-title" id="rippleTitle1">Developer Change</div>
                        <div class="mc-ripple-step-detail" id="rippleDesc1">
                            Commit modifies <code>payment.py</code> with updated currency rounding logic.
                        </div>
                    </div>
                    <span class="mc-ripple-badge" style="background: #e0f2fe; color: #0369a1;">Direct Diff (+42 lines)</span>
                </div>

                <!-- Step 2 -->
                <div class="mc-ripple-step" id="rippleStep2">
                    <div>
                        <div class="mc-ripple-step-num">Step 2</div>
                        <div class="mc-ripple-step-title" id="rippleTitle2">Direct Impact</div>
                        <div class="mc-ripple-step-detail" id="rippleDesc2">
                            AST parser identifies altered method <code>calculate_fee()</code> signature.
                        </div>
                    </div>
                    <span class="mc-ripple-badge" style="background: #dbeafe; color: #1d4ed8;">Depth 0 &bull; 1 File</span>
                </div>

                <!-- Step 3 -->
                <div class="mc-ripple-step" id="rippleStep3">
                    <div>
                        <div class="mc-ripple-step-num">Step 3</div>
                        <div class="mc-ripple-step-title" id="rippleTitle3">Downstream Ripple</div>
                        <div class="mc-ripple-step-detail" id="rippleDesc3">
                            3 downstream modules import <code>payment.py</code>: <code>billing.py</code>, <code>invoice.py</code>, <code>checkout.py</code>.
                        </div>
                    </div>
                    <span class="mc-ripple-badge" style="background: #fef3c7; color: #b45309;">Depth 1 & 2 &bull; 3 Files</span>
                </div>

                <!-- Step 4 -->
                <div class="mc-ripple-step" id="rippleStep4">
                    <div>
                        <div class="mc-ripple-step-num">Step 4</div>
                        <div class="mc-ripple-step-title" id="rippleTitle4">Regression Risk</div>
                        <div class="mc-ripple-step-detail" id="rippleDesc4">
                            12 regression test cases exercise these affected modules in the test graph.
                        </div>
                    </div>
                    <span class="mc-ripple-badge" style="background: #fce7f3; color: #be185d;">12 Suites Targeted</span>
                </div>

                <!-- Step 5 -->
                <div class="mc-ripple-step" id="rippleStep5">
                    <div>
                        <div class="mc-ripple-step-num">Step 5</div>
                        <div class="mc-ripple-step-title" id="rippleTitle5">Risk Verdict</div>
                        <div class="mc-ripple-step-detail" id="rippleDesc5">
                            Risk evaluated at 14.5 pts. Two senior code reviews mandated before merge.
                        </div>
                    </div>
                    <span class="mc-ripple-badge" style="background: #fee2e2; color: #b91c1c;">HIGH RISK (14.5 pts)</span>
                </div>
            </div>
        </div>
    </section>

    <!-- 4. "From Commit to Confidence" Interactive Workflow (01 to 08) -->
    <section class="mc-section" id="mcWorkflowSection">
        <div class="mc-section-header">
            <span class="mc-eyebrow">End-to-End Verification Pipeline</span>
            <h2 class="mc-heading">From Commit to Confidence: The SCM Pipeline</h2>
            <p class="mc-subtext">
                An 8-stage automated workflow linking Software Configuration Management baseline identification to targeted regression test verification.
            </p>
        </div>

        <div class="mc-workflow-grid" id="mcWorkflowGrid">
            <!-- Step 1 -->
            <div class="mc-wf-card selected" onclick="inspectWorkflowStep(1)" id="wfCard1">
                <div class="mc-wf-top">
                    <span class="mc-wf-num">01</span>
                    <div class="mc-wf-icon">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="18" r="3"></circle>
                            <circle cx="6" cy="6" r="3"></circle>
                            <circle cx="18" cy="6" r="3"></circle>
                            <path d="M18 9v2a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V9"></path>
                            <line x1="12" y1="12" x2="12" y2="15"></line>
                        </svg>
                    </div>
                </div>
                <div class="mc-wf-title">Git Commit</div>
                <div class="mc-wf-desc">Extracts commit metadata, author, timestamp, branch, and parent tree via GitPython.</div>
                <div class="mc-wf-tag">Git Tree Ingestion</div>
            </div>

            <!-- Step 2 -->
            <div class="mc-wf-card" onclick="inspectWorkflowStep(2)" id="wfCard2">
                <div class="mc-wf-top">
                    <span class="mc-wf-num">02</span>
                    <div class="mc-wf-icon">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                            <polyline points="14 2 14 8 20 8"></polyline>
                            <line x1="9" y1="15" x2="15" y2="15"></line>
                        </svg>
                    </div>
                </div>
                <div class="mc-wf-title">Change Detection</div>
                <div class="mc-wf-desc">Calculates exact file-level deltas, line additions, deletions, and git blame authorship.</div>
                <div class="mc-wf-tag">Delta Tracking (Layer 1)</div>
            </div>

            <!-- Step 3 -->
            <div class="mc-wf-card" onclick="inspectWorkflowStep(3)" id="wfCard3">
                <div class="mc-wf-top">
                    <span class="mc-wf-num">03</span>
                    <div class="mc-wf-icon">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="6" cy="6" r="3"></circle>
                            <circle cx="6" cy="18" r="3"></circle>
                            <circle cx="18" cy="12" r="3"></circle>
                            <line x1="8.59" y1="7.41" x2="15.42" y2="10.59"></line>
                            <line x1="8.59" y1="16.59" x2="15.42" y2="13.41"></line>
                        </svg>
                    </div>
                </div>
                <div class="mc-wf-title">Dependency Mapping</div>
                <div class="mc-wf-desc">Scans source files using AST parsing to identify all static import relationships.</div>
                <div class="mc-wf-tag">AST Graph Construction</div>
            </div>

            <!-- Step 4 -->
            <div class="mc-wf-card" onclick="inspectWorkflowStep(4)" id="wfCard4">
                <div class="mc-wf-top">
                    <span class="mc-wf-num">04</span>
                    <div class="mc-wf-icon">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="2" y1="12" x2="22" y2="12"></line>
                            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
                        </svg>
                    </div>
                </div>
                <div class="mc-wf-title">Impact Analysis (CIA)</div>
                <div class="mc-wf-desc">Traverses downstream dependents to map direct (depth 1) and transitive (depth 2) blast radius.</div>
                <div class="mc-wf-tag">BFS Graph Traversal</div>
            </div>

            <!-- Step 5 -->
            <div class="mc-wf-card" onclick="inspectWorkflowStep(5)" id="wfCard5">
                <div class="mc-wf-top">
                    <span class="mc-wf-num">05</span>
                    <div class="mc-wf-icon">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M18 20V10"></path>
                            <path d="M12 20V4"></path>
                            <path d="M6 20v-6"></path>
                        </svg>
                    </div>
                </div>
                <div class="mc-wf-title">Risk Assessment</div>
                <div class="mc-wf-desc">Quantifies change risk using an explainable mathematical formula weighting fan-out, defects, churn.</div>
                <div class="mc-wf-tag">Explainable Formula (Layer 3)</div>
            </div>

            <!-- Step 6 -->
            <div class="mc-wf-card" onclick="inspectWorkflowStep(6)" id="wfCard6">
                <div class="mc-wf-top">
                    <span class="mc-wf-num">06</span>
                    <div class="mc-wf-icon">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="9 11 12 14 22 4"></polyline>
                            <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
                        </svg>
                    </div>
                </div>
                <div class="mc-wf-title">Regression Selection</div>
                <div class="mc-wf-desc">Filters test catalog to isolate only tests exercising affected modules, skipping unrelated suites.</div>
                <div class="mc-wf-tag">RTS Minimization (Layer 2)</div>
            </div>

            <!-- Step 7 -->
            <div class="mc-wf-card" onclick="inspectWorkflowStep(7)" id="wfCard7">
                <div class="mc-wf-top">
                    <span class="mc-wf-num">07</span>
                    <div class="mc-wf-icon">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polygon points="5 3 19 12 5 21 5 3"></polygon>
                        </svg>
                    </div>
                </div>
                <div class="mc-wf-title">Automated Execution</div>
                <div class="mc-wf-desc">Executes selected PyTest suites programmatically, capturing durations, stdout, and error traces.</div>
                <div class="mc-wf-tag">PyTest Runner Engine</div>
            </div>

            <!-- Step 8 -->
            <div class="mc-wf-card" onclick="inspectWorkflowStep(8)" id="wfCard8">
                <div class="mc-wf-top">
                    <span class="mc-wf-num">08</span>
                    <div class="mc-wf-icon">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                            <polyline points="14 2 14 8 20 8"></polyline>
                            <line x1="16" y1="13" x2="8" y2="13"></line>
                            <line x1="16" y1="17" x2="8" y2="17"></line>
                        </svg>
                    </div>
                </div>
                <div class="mc-wf-title">Analysis Report</div>
                <div class="mc-wf-desc">Compiles immutable SCM audit trail, assigns release confidence status, and stores in SQLite.</div>
                <div class="mc-wf-tag">Immutable Audit Record</div>
            </div>
        </div>

        <!-- Dynamic Stage Inspector Panel -->
        <div class="mc-wf-inspector" id="mcWfInspector">
            <div class="mc-inspector-header">
                <div class="mc-inspector-title">
                    <span>Stage 01: Git Commit Ingestion</span>
                </div>
                <div class="mc-inspector-module">
                    Module: <code>core/change_detector.py</code>
                </div>
            </div>
            <div class="mc-inspector-grid">
                <div class="mc-inspector-col">
                    <h5>Input Artifact</h5>
                    <p id="inspectorInput">Git repository working tree, commit hash, parent commit reference.</p>
                    <div class="mc-inspector-code" id="inspectorInputCode">repo.commit(hash).diff(parent)</div>
                </div>
                <div class="mc-inspector-col">
                    <h5>Processing Logic</h5>
                    <p id="inspectorProcess">GitPython tree diffing, hunks parsing, author blame attribution.</p>
                    <div class="mc-inspector-code" id="inspectorProcessCode">diff_index = parent.diff(commit)</div>
                </div>
                <div class="mc-inspector-col">
                    <h5>Output Artifact</h5>
                    <p id="inspectorOutput">List of modified, added, and deleted files with per-file churn counts.</p>
                    <div class="mc-inspector-code" id="inspectorOutputCode">List[ChangedFile(path, added, deleted)]</div>
                </div>
            </div>
        </div>
    </section>

    <!-- 5. Signature Feature: Interactive "Change Impact" Demo -->
    <section class="mc-section" id="mcDemoSection">
        <div class="mc-section-header">
            <span class="mc-eyebrow">Interactive Concept Demo</span>
            <h2 class="mc-heading">Experience Real-Time Change Intelligence</h2>
            <p class="mc-subtext">
                Select a simulated modified module below to observe how CodeGuard's AST analyzer traverses import relationships, computes blast radius, and isolates regression tests.
            </p>
        </div>

        <div class="mc-demo-container">
            <div class="mc-demo-header">
                <div class="mc-demo-badge">
                    <span>Interactive Simulation Sandbox</span>
                </div>
                <div class="mc-demo-tabs">
                    <button class="mc-demo-tab active" onclick="loadSimulation('analyzer')" id="simTabAnalyzer">
                        core/analyzer.py
                    </button>
                    <button class="mc-demo-tab" onclick="loadSimulation('models')" id="simTabModels">
                        database/models.py
                    </button>
                    <button class="mc-demo-tab" onclick="loadSimulation('risk')" id="simTabRisk">
                        core/risk_analyzer.py
                    </button>
                    <button class="mc-demo-tab" onclick="loadSimulation('helpers')" id="simTabHelpers">
                        views/helpers.py
                    </button>
                </div>
            </div>

            <div class="mc-demo-body">
                <!-- Col 1: Modified File & Diff Churn -->
