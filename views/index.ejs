            return '<div class="mc-demo-test-item">' +
                '<span style="color: #10b981;">&#10004;</span>' +
                '<span>' + t + '</span>' +
            '</div>';
        }).join('');
    }

    document.getElementById('simOptimization').textContent = sim.opt;
}

// Interactive Architecture Inspector
var archData = {
    core: {
        title: "CodeGuard Core Engine (analyzer.py)",
        tag: "Pipeline Orchestration",
