function showArchInfo(key) {
    var item = archData[key];
    if (!item) return;

    ['core', 'git', 'ast', 'risk', 'pytest', 'db', 'report'].forEach(function(k) {
        var node = document.getElementById('archNode' + k.charAt(0).toUpperCase() + k.slice(1));
        if (node) {
            if (k === key) {
                node.style.borderColor = '#60a5fa';
                node.style.boxShadow = '0 0 16px rgba(96, 165, 250, 0.4)';
            } else {
                node.style.borderColor = '';
                node.style.boxShadow = '';
            }
        }
    });

    document.getElementById('archInfoTitle').textContent = 'Selected Subsystem: ' + item.title;
    document.getElementById('archInfoTag').textContent = item.tag;
    document.getElementById('archInfoDesc').textContent = item.desc;
}
